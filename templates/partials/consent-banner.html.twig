{#
    Consent banner.

    Overridable: copy to your theme's templates/partials/consent-banner.html.twig
    and it wins. Keep the data-consent-* attributes — the client script finds
    everything through them, and nothing here is styled by tag name.

    The markup is deliberately identical for every visitor. Visibility is
    decided in the browser from the consent cookie, so a full-page cache can
    serve this to everybody without leaking one person's decision to the next.
#}
<div class="consent-root"
     data-consent-banner
     data-consent-appearance="{{ appearance }}"
     data-consent-layout="{{ layout }}"
     data-consent-position="{{ position }}"
     {% if blocking %}data-consent-blocking{% endif %}>

    <script type="application/json" data-consent-payload>{{ payload_json|raw }}</script>

    {% if blocking %}
        <div class="consent-backdrop" data-consent-backdrop hidden></div>
    {% endif %}

    <div class="consent-banner"
         data-consent-panel="banner"
         role="dialog"
         aria-labelledby="consent-banner-title"
         aria-describedby="consent-banner-body"
         {% if blocking %}aria-modal="true"{% endif %}
         hidden>
        <div class="consent-banner-inner">
            <div class="consent-copy">
                <h2 class="consent-title" id="consent-banner-title">{{ content.title }}</h2>
                <div class="consent-text" id="consent-banner-body">{{ content.body|raw }}</div>

                <p class="consent-gpc" data-consent-gpc hidden>{{ content.gpc_notice }}</p>

                {% if links %}
                    <p class="consent-links">
                        {% for link in links %}
                            <a href="{{ link.url }}">{{ link.label }}</a>
                        {% endfor %}
                    </p>
                {% endif %}
            </div>

            {#
                Reject sits beside Accept at the same weight, always. Making
                refusal harder than acceptance is precisely what the CNIL fined
                Google and Meta over in 2022, so the labels and the order are
                configurable but the prominence is not.
            #}
            <div class="consent-actions">
                <button type="button" class="consent-btn consent-btn-ghost" data-consent-action="preferences">{{ content.preferences }}</button>
                <button type="button" class="consent-btn consent-btn-solid" data-consent-action="reject">{{ content.reject }}</button>
                <button type="button" class="consent-btn consent-btn-solid" data-consent-action="accept">{{ content.accept }}</button>
            </div>
        </div>
    </div>

    {% include 'partials/consent-preferences.html.twig' %}

    <button type="button"
            class="consent-badge"
            data-consent-open
            data-consent-badge
            aria-label="{{ content.reopen_label|e('html_attr') }}"
            title="{{ content.reopen_label|e('html_attr') }}"
            hidden>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5Z"/>
            <circle cx="9" cy="10" r="1.3" fill="var(--consent-bg)"/>
            <circle cx="13.5" cy="14.5" r="1.3" fill="var(--consent-bg)"/>
            <circle cx="8" cy="15" r="1" fill="var(--consent-bg)"/>
        </svg>
    </button>
</div>
